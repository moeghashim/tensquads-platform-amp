[37.316597, "o", "GET /v1/tasks/demo-1795040288812 -> status running, attempt 1, turn 2, tool read_file\r\n"]
[37.344172, "o", "\r\n== The demo kills the runner of attempt 1 in turn 2 (SIGKILL 231092)\r\n\r\n"]
