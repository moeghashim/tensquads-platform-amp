[1.813393, "o", "\r\n== The plan example and Q1 to Q8 with Petra and the gate (Postgres)\r\n"]
[1.813578, "o", "\r\n$ cd apps/platform && npx tsx --test test/decisions.test.ts test/plugins.test.ts 2>&1 | grep -E '^ *(✔|✖) (Q[0-9]+|the plan|Plan)|^ℹ (tests|fail)'\r\n"]
[2.833019, "o", "✔ Plan example: three sure answers give the $15 refund with no approval, with three records (263.720867ms)\r\n"]
[3.069348, "o", "✔ Plan example: one answer below the level gives an approval request, and no refund goes out (237.289886ms)\r\n"]
[3.2593, "o", "✔ Plan example: $60 always gives an approval request (189.073262ms)\r\n"]
[3.818191, "o", "✔ Q7: a decider that says yes at 0.99 cannot start a $60 refund, a money action with no rule, or a public action (559.5342ms)\r\n"]
