[0.007475, "o", "\u001b[33md97d213\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32m09-decisions\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/main\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/HEAD\u001b[m\u001b[33m)\u001b[m Merge pull request #13 from moeghashim/08-memory\r\n"]
[0.007648, "o", "\r\n== The tests of Q1 to Q8 in the packages\r\n\r\n$ npm test -w @tensquads/decisions -w @tensquads/adapters-test 2>&1 | grep -E '^ *✔ Q[0-9]+|^ℹ (tests|fail)'\r\n"]
[0.441831, "o", "✔ Q1: the list has the six points of the plan, each with its id, question, type, options, harm, level and path below the level (1.810679ms)\r\n"]
[0.443476, "o", "✔ Q1: the level of each point comes from the one file of levels, and is 0.90 for each yes or no point and each choice (0.19119ms)\r\n"]
[0.443883, "o", "✔ Q2: the three questions of a refund go to the decider in one call, each with its type and its options (3.438971ms)\r\n"]
