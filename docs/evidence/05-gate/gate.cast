[0.007894, "o", "$ git log --oneline -1\r\n"]
[0.010358, "o", "\u001b[33m9fb01fb\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32m05-gate\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/main\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/HEAD\u001b[m\u001b[33m)\u001b[m Merge pull request #9 from moeghashim/04-loop\r\n"]
[0.010621, "o", "\r\n== The tests of G1 to G12 in the packages\r\n"]
[0.010678, "o", "\r\n$ npm test -w @tensquads/gate -w @tensquads/loop -w @tensquads/link -w @tensquads/runner -w @tensquads/adapters-test 2>&1 | grep -E '^ *✔ G[0-9]+|^ℹ (tests|fail)'\r\n"]
[0.54694, "o", "✔ G4: the content hash does not depend on the order of the keys, and changes with the content (22.522644ms)\r\n"]
[0.5473, "o", "✔ G5: the id of an action is the task id and the tool-call id (0.296348ms)\r\n✔ G2: a money action at or below the limit needs nothing; above it, or with no rule, it needs an approval (1.112522ms)\r\n✔ G3: a public action always needs an approval, and the kind other needs nothing (0.25548ms)\r\n"]
[0.558849, "o", "ℹ tests 4\r\n"]
[0.559064, "o", "ℹ fail 0\r\n"]
[1.201355, "o", "✔ G5: the action tool saves a journal copy before it calls action, and uses the tool-call id (102.027528ms)\r\n"]
[1.282376, "o", "✔ G5: after a stop during action, the new attempt asks the gate with the same id, and the model does not ask again (79.010937ms)\r\n"]
[1.325166, "o", "✔ G1: the action tool calls only link.action, and the bot gives no code for an action tool (45.092683ms)\r\n"]
[1.384208, "o", "✔ G5: wait parks, the task stops waiting, and an approve signal gives done to the same tool-call id (59.094093ms)\r\n"]
[1.474344, "o", "✔ G10: a reject signal gives the model a refusal with the reason, and no done (89.591198ms)\r\n"]
[1.519332, "o", "✔ G11: a step that changes a file sends the file to draft, and a read sends nothing (44.737948ms)"]
[1.519418, "o", "\r\n"]
[1.549731, "o", "✔ G11: a new attempt writes the drafts of start into the work directory before the loop resumes (30.792686ms)\r\n"]
[1.629804, "o", "✔ G11: after a stop before the copy, the new attempt has the append one time at the end (80.8285ms)\r\n"]
[3.062738, "o", "ℹ tests 20\r\n"]
[3.063, "o", "ℹ fail 0\r\n"]
[3.4909, "o", "✔ G1: an action call goes to the gateway with the tool-call id and the content, and gives the answer (14.064092ms)\r\n✔ G1: an answer of action that does not pass its schema is an error (0.815549ms)\r\n"]
[3.49171, "o", "✔ G11: a draft call sends the path and the base64 body, and tries again after a server error (1.67391ms)\r\n"]
[3.503405, "o", "ℹ tests 12\r\n"]
[3.503671, "o", "ℹ fail 0\r\n"]
[4.049116, "o", "✔ G1: no row of the plug-in list of the runner provides or needs the channel or the payment port (6.539861ms)\r\n✔ G1: no package that the runner needs at run time uses the channel or the payment port (2.041509ms)\r\n✔ G1: the check finds a use of a service port (0.183394ms)\r\n"]
[4.476317, "o", "ℹ tests 8\r\n"]
[4.476589, "o", "ℹ fail 0\r\n"]
[5.388871, "o", "✔ G2: the goal 'refund 15 to cust-1' makes one refund call, then the final answer (2.702716ms)\r\n"]
[5.390483, "o", "✔ G3: the goal 'reply hello to cust-1' makes one send_reply call (0.972459ms)\r\n✔ G8: 'refund 40 then 45 after a restart' asks for 40 the first time and 45 each later time (1.64507ms)\r\n"]
[5.390713, "o", "✔ G11: the append script appends one line in each turn, then reads the file (1.751806ms)\r\n"]
[5.715476, "o", "✔ G9: a held payment is recorded at once, and answers only after the release (16.437439ms)\r\n"]
[5.7315, "o", "ℹ tests 50\r\n"]
[5.731648, "o", "ℹ fail 0\r\n"]
[5.747534, "o", "[exit 0]\r\n\r\n$ cd apps/platform && npx tsx --test 'test/**/*.test.ts' 2>&1 | grep -E '^ *(✔|✖) G[0-9]+|^ℹ (tests|fail)'\r\n"]
[6.925224, "o", "✔ G11: start gives, for each path, the newest draft that is not newer than the journal copy (347.439617ms)\r\n"]
[7.098453, "o", "✔ G1: an action call on the gateway goes to the gate, and a copy of the call number gets the saved answer (173.886907ms)\r\n"]
[7.09875, "o", "✔ G2: Petra handles SetRule and ApprovalDecision, so the Worker accepts them (0.263765ms)\r\n"]
[7.668055, "o", "✔ G2: a refund of $15 inside a limit of $20 goes out with no approval (262.667007ms)\r\n"]
[7.8756, "o", "✔ G2: the newest active money_limit rule wins, and a money action with no rule needs an approval (207.0555ms)\r\n"]
[8.011613, "o", "✔ G3: a public action always needs the approval of the owner, also with a money limit (136.36347ms)\r\n"]
[8.337641, "o", "✔ G4: an approval belongs to one content; a wrong hash changes nothing, and a new content needs a new approval (325.886295ms)\r\n"]
[8.435963, "o", "✔ G6: the gate writes started before the service call, puts a check job in the queue, and writes done after it (98.00772ms)\r\n"]
[8.551009, "o", "✔ G7: an id that comes again with done gives the saved answer, and the action does not run again (114.949825ms)\r\n"]
[8.668744, "o", "✔ G8: an id that comes again with a different content is refused with a trail row, and no second send goes out (117.920541ms)\r\n"]
[8.77291, "o", "✔ G9: a copy of an action call while the payment waits gets busy; the action gets done and never not_confirmed (104.070901ms)\r\n"]
[8.929884, "o", "✔ G9: a call from a new attempt while the call of the old attempt still runs in Petra gets busy (156.436455ms)\r\n"]
[9.055261, "o", "✔ G9: a service that cannot confirm gives not_confirmed, no repeat, and Petra sends action_not_confirmed (125.681443ms)\r\n"]
[9.287603, "o", "✔ G10: a rejected approval gives the status rejected, a refusal to the model, and no send (231.593144ms)\r\n"]
[9.606804, "o", "✔ G10: an approved action goes out one time, on the next call with the same id and hash (319.636254ms)\r\n"]
[9.811864, "o", "✔ G4: Petra stops after the pending action and before the request; the owner gets the request one time (204.968624ms)\r\n"]
[10.086856, "o", "✔ G10: an ApprovalDecision for a task that was cancelled sends no action, and the owner gets a status message (252.231411ms)\r\n"]
[10.219588, "o", "✔ G12: Petra stops between started and done; the service status decides, and the action goes out one time (154.478064ms)\r\n"]
[10.317672, "o", "✔ G12: Petra stops after started and before the service got it; the copy of the call sends it one time (99.127514ms)\r\n"]
[10.493074, "o", "✔ G9: the check action job waits for the tool limit, then sets not_confirmed and tells the owner (172.343757ms)\r\n"]
[10.736097, "o", "✔ G10: the owner decides before the task waits; when the runner parks, a new attempt starts one time (246.305569ms)\r\n"]
[18.049217, "o", "ℹ tests 57\r\n"]
[18.049692, "o", "ℹ fail 0\r\n"]
[18.065782, "o", "[exit 0]\r\n\r\n"]
[18.065849, "o", "== The tests of the full path: a kill of the runner at each of the four points of G12, G8 and G11\r\n\r\n$ cd apps/launcher && npx tsx --test --test-concurrency=1 test-e2e/gate.test.ts 2>&1 | grep -E '^(✔|✖)|^ℹ (tests|fail)'\r\n"]
[26.673778, "o", "✔ G12 and G5: the runner is killed before the call to the gate, and the refund goes out one time (7993.39076ms)\r\n"]
[30.763839, "o", "✔ G12 and G6: the runner is killed after started and before done, and the refund goes out one time (4091.464417ms)\r\n"]
[35.251159, "o", "✔ G12 and G7: the runner is killed after done, before the answer reaches it, and the refund goes out one time (4487.279096ms)\r\n"]
[38.817565, "o", "✔ G12: the runner is killed after the answer came back and before the next copy, and the refund goes out one time (3565.058705ms)\r\n"]
[42.688428, "o", "✔ G8: the model asks for $40, then for $45 with the same tool-call id; the gate refuses, and one send goes out (3871.973799ms)\r\n"]
[45.23825, "o", "✔ G11: a file is appended after the last copy and the runner is killed; the append is there one time (2548.201596ms)\r\n"]
[45.789196, "o", "ℹ tests 6\r\n"]
[45.789632, "o", "ℹ fail 0\r\n"]
[45.806863, "o", "[exit 0]\r\n"]
[45.807067, "o", "\r\n== The demo: npm run dev:platform runs in a second terminal. A refund of $60, above the limit of $20.\r\n\r\n$ npm run demo:gate --silent\r\n"]
[46.07518, "o", "== The owner sets a rule: refunds of $20 or less need no approval\r\n"]
[46.109548, "o", "POST /v1/commands SetRule -> 200 {\"status\":\"accepted\",\"commandId\":\"rule-1795044532355\"}\r\n"]
[46.112718, "o", "\r\n== The owner asks: \"Please refund 60 to cust-1\" (task refund-1795044532355)\r\n"]
[46.14884, "o", "POST /v1/commands OwnerMessage -> 200 {\"status\":\"accepted\",\"commandId\":\"refund-1795044532355\"}\r\n"]
[49.02635, "o", "\r\n== Petra asks for an approval (seq 7)\r\n{\r\n  \"rule\": \"rule-1795044532355\",\r\n  \"type\": \"approval_request\",\r\n  \"limit\": 20000000,\r\n  \"action\": \"refund\",\r\n  \"content\": \"refund {\\\"amount\\\":60,\\\"currency\\\":\\\"USD\\\",\\\"to\\\":\\\"cust-1\\\"}\",\r\n  \"approvalId\": \"refund-1795044532355/call-1\",\r\n  \"contentHash\": \"7601c45e08fe1cf83c02331ed4353a3e201129eba6fbbffbd654ca4c7073e31f\",\r\n  \"seq\": 7,\r\n  \"at\": \"2026-11-18T23:28:55.317Z\"\r\n}\r\n"]
[49.130304, "o", "GET /v1/tasks/refund-1795044532355 -> status waiting for the owner. No runner runs, and no refund went out.\r\n"]
[49.130821, "o", "\r\n== The owner approves the exact content (its hash)\r\n"]
[49.211333, "o", "POST /v1/commands ApprovalDecision -> 200 {\"status\":\"accepted\",\"commandId\":\"approve-1795044532355\"}\r\n"]
[50.981274, "o", "GET /v1/tasks/refund-1795044532355 -> status done, attempt 2\r\n"]
[50.981611, "o", "\r\n== The result (seq 8):\r\nResult: Please refund 60 to cust-1\r\n{\"outcome\":\"confirmed\",\"actionId\":\"refund-1795044532355/call-1\"}\r\n"]
[51.000946, "o", "[exit 0]\r\n"]
[51.001265, "o", "\r\n"]
[51.001324, "o", "== The log of the Worker: the payment adapter got one send\r\n"]
[51.001417, "o", "\r\n"]
[51.00145, "o", "$ amp orb service logs platform-dev 2>&1 | grep -o 'payment-test: send refund-.*' | tail -1\r\n"]
[51.438755, "o", "payment-test: send refund-1795044532355/call-1\r\n"]
[51.439271, "o", "[exit 0]\r\n"]
