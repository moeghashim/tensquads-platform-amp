[0.009529, "o", "\u001b[33m400513d\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32m08-memory\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/main\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/HEAD\u001b[m\u001b[33m)\u001b[m Merge pull request #12 from moeghashim/07-credits-and-trail\r\n"]
[0.009812, "o", "\r\n== The tests of M1 to M13 (Postgres, with the role of Petra)\r\n"]
[0.009865, "o", "\r\n$ npm test -w @tensquads/memory -w @tensquads/checker -w @tensquads/loop 2>&1 | grep -E '^ *✔ M[0-9]+|^ℹ (tests|fail)'\r\n"]
[0.546746, "o", "✔ M13: the cleaning function removes the name, each part of the name, the address, phone numbers and emails (3.660589ms)\r\n"]
[0.547655, "o", "✔ M13: the cleaning function keeps a text with no data of the customer, and does not cut a longer word (0.210946ms)\r\n"]
[0.548093, "o", "✔ M13: the cleaning function removes an Arabic name and an address that is an email (7.867893ms)\r\n"]
[0.809271, "o", "✔ M12: the regular text has one form of alef, no diacritics, no tatweel and no capital letters (0.904152ms)\r\n"]
[0.810066, "o", "✔ M12: the search query has each word of the regular text one time, joined with or (1.617904ms)\r\n"]
[0.835392, "o", "ℹ tests 5\r\n"]
[0.835826, "o", "ℹ fail 0\r\n"]
[1.217373, "o", "✔ M9: a result that has the text of a fact on the forget list of the task does not reach the checker model (0.305767ms)\r\n"]
[1.243284, "o", "ℹ tests 5\r\n"]
[1.243586, "o", "ℹ fail 0\r\n"]
[2.890694, "o", "✔ M9: Petra removes the text of a forgotten fact from her next model request (26.805401ms)\r\n"]
[2.997709, "o", "✔ M8: a new conversation of Petra starts from the history only; the old one stays; idle tells a run in progress (123.206475ms)\r\n"]
[4.010139, "o", "ℹ tests 22\r\n"]
[4.010467, "o", "ℹ fail 0\r\n"]
[4.028919, "o", "[exit 0]\r\n"]
[4.029009, "o", "\r\n$ cd apps/platform && npx tsx --test test/memory.test.ts test/night.test.ts test/customer.test.ts 2>&1 | grep -E '^ *(✔|✖) M[0-9]+|^ℹ (tests|fail)'\r\n"]
[6.067605, "o", "✔ M13: after 12 months and one night job, no place of section 7.8 has text of the customer; another customer does not change; an approved fact stays with no name; a brief of another task that copies her facts keeps its ids with no text of her (1291.142863ms)\r\n"]
[6.625521, "o", "✔ M13: a deletion is due while a sandbox runs and an action is started: the task is cancelled, later calls are refused, nothing is deleted; after done, the next night job deletes; the credits go back one time (560.629964ms)\r\n"]
[7.291579, "o", "✔ M1: the memory has four layers: the record of messages, notes, pages and the core (367.604134ms)\r\n"]
[7.646175, "o", "✔ M2: the system sets the origin of each fact; a proposed fact that looks like an owner fact gets the origin bot (353.275048ms)\r\n"]
[8.12289, "o", "✔ M3: a fact from a task of a customer is not trusted and never goes into the core; only the owner promotes a fact (478.425921ms)\r\n"]
[8.57511, "o", "✔ M4: each page accepts facts from one bot; a fact of a bot never changes or replaces a fact of the owner (452.114704ms)\r\n"]
[8.759858, "o", "✔ M5: a search finds only rows of its own account and of the read list of the bot (184.689258ms)\r\n"]
[9.005787, "o", "✔ M6: search is by words, and the brief has the core items, then the best facts for the words of the goal, each with its id (245.735624ms)\r\n"]
[9.996623, "o", "✔ M7: the core takes 25 items; a 26th is refused until the owner removes one; the night job proposes below 20 only (987.914709ms)\r\n"]
[10.326999, "o", "✔ M8: a forget hides the fact from search at once; undo restores it; undo after 31 days is refused (330.639492ms)\r\n"]
[10.745703, "o", "✔ M9: a forget goes to the forget list of each open task whose brief has the fact; start and inbox give the full list; undo keeps it (420.854426ms)\r\n"]
[11.004136, "o", "✔ M9: the check of a result that has the text of a forgotten fact answers continue (258.331856ms)\r\n"]
[11.147662, "o", "✔ M12: a search finds an Arabic fact with a different form of alef and with diacritics; an English search works too (145.121407ms)\r\n"]
[11.747753, "o", "✔ M10: the night job reads only the owner messages of the local day before its date and proposes, with the ids of the messages as evidence (299.697569ms)\r\n"]
[12.152576, "o", "✔ M10: the night job proposes three items or fewer for each ISO week, over several nights (405.191481ms)\r\n"]
[12.983723, "o", "✔ M10: the night job proposes nothing when the core has 20 items (751.356436ms)\r\n"]
[12.984038, "o", "✔ M11: each account gets one night job for each local date at 02:00 local time, also on a day with a clock change (79.210929ms)\r\n"]
[13.348385, "o", "✔ M8: the night job deletes a fact forgotten 31 days ago; a fact forgotten 29 days ago stays and can be undone (364.879183ms)\r\n"]
[13.707849, "o", "✔ M13: the night job deletes the drafts and the journal copies of an ended task; those of an open task stay (359.69605ms)\r\n"]
[14.113371, "o", "✔ M8: at the night job, a conversation older than 90 days is replaced only when Petra is idle; a forgotten text stays out of her requests after its row is deleted (406.720433ms)\r\n"]
