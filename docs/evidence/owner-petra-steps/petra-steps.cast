[0.005992, "o", "\r\n\u001b[1;36m$ npx tsx --test --test-name-pattern=\"step\" apps/platform/test/petra-model.test.ts 2>&1 | grep -E \"^(✔|✖|ℹ (pass|fail))\"\u001b[0m\r\n"]
[1.065034, "o", "✔ N4: each model call of a command is one step with the provider, the model, the time, the tokens and the chosen tools (145.771402ms)\r\n"]
[1.065375, "o", "✔ N4: each tool run is one step with its time; a tool that throws is a failed step and the error goes on (1.86493ms)\r\n✔ N4: the storage keeps the steps of the last 50 commands only (2.353709ms)\r\n"]
