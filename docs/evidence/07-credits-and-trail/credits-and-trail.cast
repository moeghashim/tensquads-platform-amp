[0.005806, "o", "$ git log --oneline -1\r\n"]
[0.00941, "o", "\u001b[33m635a7fb\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32m07-credits-and-trail\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/main\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/HEAD\u001b[m\u001b[33m)\u001b[m Merge pull request #11 from moeghashim/06-checker\r\n"]
[0.009766, "o", "\r\n== The tests of T1 to T8 (Postgres, with the role of Petra)\r\n\r\n$ cd apps/platform && npx tsx --test test/credits.test.ts test/trail.test.ts 2>&1 | grep -E '^ *(✔|✖) T[0-9]+|^ℹ (tests|fail)'\r\n"]
[1.085922, "o", "✔ T1: a task does not start when the balance is lower than the price; the owner gets a clear message (270.899864ms)\r\n"]
[1.646072, "o", "✔ T2: a task with two attempts and ten model calls has one charge row with the price of its task type (559.481363ms)\r\n"]
[2.330512, "o", "✔ T3: the credits go back after a stop at a limit, a cancel for a deletion, and an owner cancel before a start; one row each, also when the step runs two times (684.658096ms)\r\n"]
[2.472464, "o", "✔ T4: the balance is a query on the ledger, and no table or view has a column for a sum (142.996721ms)\r\n"]
[3.029208, "o", "✔ T5: each step of a task is one row with its task, attempt, turn, seq, actor, kind and time (254.447279ms)\r\n"]
[3.38919, "o", "✔ T5: the role of Petra cannot change or delete a ledger row or a trail row, except the deletion of T8 (359.991802ms)\r\n"]
[3.796797, "o", "✔ T6: one query gives the full trail of a task with two attempts, from the owner message to the result (407.087904ms)\r\n"]
[3.908611, "o", "✔ T7: a large item goes to the object store; the row keeps the link and the SHA-256 hash (112.095298ms)\r\n"]
[4.246345, "o", "✔ T8: the night job deletes the trail of a task that ended 32 days ago, with its items, and keeps an open task and the approvals (338.248824ms)\r\n"]
[4.257042, "o", "ℹ tests 9\r\nℹ fail 0\r\n"]
[4.273759, "o", "[exit 0]\r\n"]
[4.273825, "o", "\r\n== The demo: npm run dev:platform runs in a second terminal. One task of the test bot.\r\n\r\n$ DATABASE_URL=postgres://postgres:spike@127.0.0.1:5433/ts_demo npm run demo:trail --silent\r\n"]
[4.679395, "o", "== The balance before the task: 100 credits\r\n"]
[4.679482, "o", "\r\n== The owner sends: \"Please read 2 files.\" (task demo-1795071870316)\r\n"]
[6.366202, "o", "\r\n== The full trail of the task, in one query (requirement T6)\r\n"]
[6.368687, "o", "   1  attempt -, turn -    owner message          owner     The owner asked for a task.\r\n"]
[6.369627, "o", "   2  attempt -, turn -    message to the owner   petra     Petra sent a message of the type reply to the owne\r\n"]
[6.369766, "o", "   3  attempt 1, turn 1    model call             test-bot  The model answered in turn 1.\r\n"]
[6.369781, "o", "   4  attempt 1, turn 1    tool use               test-bot  The shop opens at 9:00 and closes at 17:00, from M\r\n   5  attempt 1, turn 2    model call             test-bot  The model answered in turn 2.\r\n   6  attempt 1, turn 2    tool use               test-bot  The shop opens at 9:00 and closes at 17:00, from M\r\n"]
[6.3701, "o", "   7  attempt 1, turn 3    model call             test-bot  The model answered in turn 3.\r\n"]
[6.370145, "o", "   8  attempt 1, turn -    check                  test-bot  The result stands: Checker model: The result is no\r\n   9  attempt -, turn -    message to the owner   petra     Petra sent a message of the type result to the own\r\n\r\n== The ledger rows of the task\r\n"]
[6.371035, "o", "task/demo-1795071870316/charge  charge  -1\r\n"]
[6.371556, "o", "\r\n== The balance after the task: 99 credits\r\n"]
[6.387017, "o", "[exit 0]\r\n"]
