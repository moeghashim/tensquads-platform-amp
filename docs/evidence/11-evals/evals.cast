[0.015525, "o", "\r\n== The tests of E1 to E6\r\n\r\n$ npm test -w @tensquads/contracts -w @tensquads/evals -w @tensquads/evals-app 2>&1 | grep -E '^ *✔ E[0-9]|^ℹ (tests|fail)'\r\n"]
[1.379507, "o", "✔ E1: a case has an id, the input, the setup, the expected outcome, the grader and tags; the setup has defaults (11.033347ms)\r\n"]
[1.382043, "o", "✔ E1: the input is an ordered list of steps; each step after the first has a condition, and the first has none (2.557185ms)\r\n✔ E1: the grader is code, the checker model or a person; a code grader needs at least one check (0.922476ms)\r\n✔ E1: the setup gives the outcome of the channel and the payment, and the answers of the fixed decider (1.096439ms)\r\n✔ E3: a version has a name, the settings of the Worker and of the launcher; E5: a decider item has a label (1.41883ms)\r\n"]
[1.660153, "o", "ℹ tests 30\r\nℹ fail 0\r\n"]
[2.057131, "o", "✔ E5: for each point the report gives the agreement, the wrong answers above the level, the time and the cost (1.931908ms)\r\n"]
[2.057937, "o", "✔ E5: an answer that is not valid or a timeout is not an agreement (0.261211ms)\r\n"]
