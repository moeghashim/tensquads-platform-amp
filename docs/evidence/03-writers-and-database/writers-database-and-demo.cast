[9.067857, "o", "\r\n== V4 ran against the Neon branch ci-db (masked output in the pull request)\r\n\r\n== The demo: npm run dev:platform runs in a second terminal, on a new empty database\r\n\r\n$ npm run demo:platform --silent\r\n"]
[9.233283, "o", "== A super admin makes the account and adds the owner\r\n"]
[9.375804, "o", "POST /v1/admin/commands -> 200 {\"status\":\"accepted\",\"commandId\":\"account-a\"}\r\n"]
[9.416486, "o", "POST /v1/admin/commands -> 200 {\"status\":\"accepted\",\"commandId\":\"account-a/owner-a\"}\r\n"]
[9.435964, "o", "GET  /v1/messages?after=0 -> 200 {\"messages\":[]}\r\n"]
[9.436441, "o", "\r\n== The owner opens the stream after seq 0\r\n"]
[9.462864, "o", "\r\n== The owner sends a message\r\n"]
[9.489562, "o", "POST /v1/commands -> 200 {\"status\":\"accepted\",\"commandId\":\"demo-1795034133188\"}\r\n"]
[9.536513, "o", "\r\n== On the stream: {\"text\":\"Hello Petra\",\"type\":\"reply\",\"seq\":2,\"at\":\"2026-11-18T20:35:33.473Z\"}\r\n"]
