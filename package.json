{
	"name": "tensquads-platform",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "npm@11.19.1",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces --if-present",
		"build": "npm run build --workspaces --if-present",
		"pretest": "npm run build -w packages --if-present --silent",
		"test": "node --test scripts/test/*.test.mjs && npm run test --workspaces --if-present",
		"pr:ready": "node scripts/pr-readiness.mjs",
		"fallow:audit": "fallow audit --changed-since origin/main",
		"preview:cloudflare": "npm run cf:preview -w @tensquads/web",
		"build:cloudflare": "npm run cf:build -w @tensquads/web",
		"deploy:cloudflare": "npm run cf:deploy -w @tensquads/web",
		"typegen:cloudflare": "npm run cf:typegen -w @tensquads/web",
		"preflight:native-deps": "node scripts/preflight-native-deps.mjs",
		"check": "npm run preflight:native-deps && biome check --error-on-warnings . && node scripts/check-file-length.mjs && node scripts/check-boundaries.mjs && tsc --noEmit && npm run check --workspaces --if-present",
		"fix": "npm run preflight:native-deps && biome check --write --error-on-warnings .",
		"doctor": "node scripts/doctor.mjs",
		"docs:list": "node scripts/docs-list.mjs",
		"agent:check": "node scripts/agent-check.mjs",
		"agent:verify-upstream": "node scripts/agent-sync.mjs verify",
		"skills:sync": "node scripts/agent-sync.mjs sync",
		"skills:verify": "node scripts/agent-sync.mjs verify-local",
		"commit:selective": "bash scripts/committer",
		"commit:with-progress": "node scripts/commit-with-progress.mjs",
		"reinstall:clean": "node scripts/reinstall-clean.mjs",
		"version:sync": "node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
		"version:patch": "npm version patch -ws --no-git-tag-version && npm run version:sync",
		"version:minor": "npm version minor -ws --no-git-tag-version && npm run version:sync",
		"version:major": "npm version major -ws --no-git-tag-version && npm run version:sync",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"release:tag": "node scripts/release-tag.mjs",
		"prepare": "node scripts/prepare.mjs",
		"db:migrate": "node scripts/db-migrate.mjs",
		"db:users": "node scripts/db-users.mjs",
		"db:setup": "npm run db:migrate && npm run db:users",
		"dev:platform": "node scripts/dev.mjs",
		"demo:platform": "node scripts/demo-platform.mjs",
		"demo:loop": "node scripts/demo-loop.mjs",
		"demo:gate": "node scripts/demo-gate.mjs",
		"demo:trail": "node scripts/demo-trail.mjs",
		"demo:memory": "node scripts/demo-memory.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/node": "^26.6.6",
		"fallow": "3.41.0",
		"husky": "^9.1.7",
		"pg": "8.23.1",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"yaml": "2.9.1"
	},
	"overrides": {
		"@node-minify/core": {
			"glob": "12.0.0"
		},
		"@earendil-works/chord": "$@earendil-works/chord",
		"@earendil-works/pi-ai": "$@earendil-works/pi-ai",
		"@earendil-works/pi-codemode": "$@earendil-works/pi-codemode",
		"@earendil-works/pi-durable": "$@earendil-works/pi-durable",
		"@earendil-works/pi-schema": "$@earendil-works/pi-schema",
		"@earendil-works/pi-telemetry": "$@earendil-works/pi-telemetry"
	},
	"engines": {
		"node": "26.x"
	},
	"dependencies": {
		"@earendil-works/chord": "file:vendor/pi/earendil-works-chord-1.5.2.tgz",
		"@earendil-works/pi-ai": "file:vendor/pi/earendil-works-pi-ai-1.5.2.tgz",
		"@earendil-works/pi-codemode": "file:vendor/pi/earendil-works-pi-codemode-1.5.2.tgz",
		"@earendil-works/pi-durable": "file:vendor/pi/earendil-works-pi-durable-1.5.2.tgz",
		"@earendil-works/pi-schema": "file:vendor/pi/earendil-works-pi-schema-1.5.2.tgz",
		"@earendil-works/pi-telemetry": "file:vendor/pi/earendil-works-pi-telemetry-1.5.2.tgz"
	}
}
