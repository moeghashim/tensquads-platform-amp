{
	"name": "@tensquads/core",
	"version": "0.0.2",
	"description": "Core library",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./contract-tests": {
			"types": "./dist/contract-tests/index.d.ts",
			"default": "./dist/contract-tests/index.js"
		}
	},
	"files": [
		"dist/**/*",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "tsx --test \"test/**/*.test.ts\"",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"cordis": "4.0.0-rc.13"
	}
}
