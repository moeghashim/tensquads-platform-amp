{
	"name": "@tensquads/evals-app",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"main": "./src/main.ts",
	"scripts": {
		"start": "tsx src/main.ts",
		"check": "tsc -p tsconfig.json --noEmit",
