		"@tensquads/core": "0.0.2",
		"@tensquads/costs": "0.0.2",
		"@tensquads/decisions": "0.0.2",
		"@tensquads/evals": "0.0.2",
		"@tensquads/memory": "0.0.2",
		"pg": "8.23.1"
	},
	"devDependencies": {
		"@tensquads/bot-test": "0.0.2",
		"@types/pg": "8.23.1"
	}
}
