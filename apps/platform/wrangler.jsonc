{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tensquads-platform",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{ "name": "PETRA", "class_name": "PetraObject" },
			{ "name": "PLATFORM", "class_name": "PlatformDurableObject" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PetraObject", "PlatformDurableObject"] }],
	// The copies of the journal and the draft files (section 7.4). The keys start with accounts/{accountId}/.
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "tensquads-files" }],
	// The queue "jobs": Petra puts the "check task" and "check action" jobs in it, and the Platform object the night jobs. The same Worker takes them.
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "jobs" }],
		"consumers": [{ "queue": "jobs", "max_batch_size": 10, "max_batch_timeout": 1 }]
	},
	// The schedule of the night job (section 10.1): one tick each hour. The Platform object starts the job of each account.
	"triggers": { "crons": ["0 * * * *"] },
	// The settings of section 10. PASS_KEY, LAUNCHER_KEY and the database URLs are secrets (.dev.vars locally).
	"vars": {
		"WORKER_COMMIT": "local",
		"ATTEMPT_MAX_MS": "1800000",
		"SILENT_MS": "120000",
		"LAUNCHER_TAKE_WAIT_MS": "2000",
		"TOOL_LIMIT_MS": "60000",
		// The time limit of one decider call (task 09), and the second decider of the shadow mode: "none" or "fixed".
		"DECIDER_TIMEOUT_MS": "5000",
		"SHADOW_DECIDER": "none",
		// The value of one credit in millionths of a US dollar (5 cents), and the take time of a sandbox request (task 10).
		"CREDIT_VALUE_MICROS": "50000",
		"LAUNCHER_TAKE_TIME_MS": "30000",
		// Only for the tests of the full path: each payment of the test adapter waits this long.
		"PAYMENT_HOLD_MS": "0",
		// Only for the Worker of an eval (task 11). The eval runner sets them for each version and each case.
		// "yes": the channel and the payment only record what they would send, and no action goes out.
		"NO_OUTGOING_ACTION": "no",
		// "yes": the test identity knows the owner of each eval account.
		"EVAL_OWNERS": "no",
		// The outcome of each send of the test adapters: "confirmed", "not_sent" or "unknown".
		"CHANNEL_OUTCOME": "confirmed",
		"PAYMENT_OUTCOME": "confirmed",
		// The answers of the fixed decider for each decision point, as JSON.
		"FIXED_DECIDER_POINTS": "{}",
		// The variant of the script of the rule model: "base" or "refund-double".
		"TEST_MODEL_SCRIPT": "base",
		// Only for the tests of the full path: each answer of the rule model waits this long.
		"MODEL_HOLD_MS": "0",
		// The time limit of one model call of Petra (requirement N6). After it, Petra tries one more time.
		"MODEL_TIMEOUT_MS": "60000",
		// The model of Petra for an account with the "real" profile (task 12). The plug-in row names the provider,
		// and the secret <PROVIDER>_API_KEY has the key. PETRA_MODEL_BASE_URL is an optional other address.
		"PETRA_MODEL": "gpt-6.2-sol"
	},
	"observability": {
		"enabled": true
	}
}
