{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tensquads-platform",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{ "name": "PETRA", "class_name": "PetraObject" },
			{ "name": "PLATFORM", "class_name": "PlatformDurableObject" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PetraObject", "PlatformDurableObject"] }],
	// The copies of the journal (section 7.4). The keys start with accounts/{accountId}/.
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "tensquads-files" }],
	// The queue "jobs": Petra puts the "check task" jobs in it. The same Worker takes them.
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "jobs" }],
		"consumers": [{ "queue": "jobs", "max_batch_size": 10, "max_batch_timeout": 1 }]
	},
	// The settings of section 10. PASS_KEY, LAUNCHER_KEY and the database URLs are secrets (.dev.vars locally).
	"vars": {
		"WORKER_COMMIT": "local",
		"ATTEMPT_MAX_MS": "1800000",
		"SILENT_MS": "120000",
		"LAUNCHER_TAKE_WAIT_MS": "2000"
	},
	"observability": {
		"enabled": true
	}
}
