{
	"name": "@tensquads/launcher",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"main": "./dist/main.js",
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/main.js",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "tsx --test \"test/**/*.test.ts\" && npm run test:e2e",
		"test:e2e": "tsx --test --test-concurrency=1 \"test-e2e/*.test.ts\""
	},
	"engines": {
		"node": "26.x"
	},
	"devDependencies": {
		"@tensquads/gateway": "0.0.2",
		"@tensquads/bots": "0.0.2"
	}
}
