{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tensquads-web",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// The owner page calls the Platform Worker through this binding. A Worker cannot fetch another workers.dev
	// Worker of the same account by its URL (Cloudflare error 1042).
	"services": [{ "binding": "PLATFORM", "service": "tensquads-platform" }],
	"observability": {
		"enabled": true
	}
}
