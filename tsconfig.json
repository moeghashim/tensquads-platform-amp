{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"@tensquads/core/contract-tests": [
				"./packages/core/src/contract-tests/index.ts"
			],
			"@tensquads/*": [
				"./packages/*/src/index.ts"
			]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"apps/platform/test/**/*",
		"apps/runner/test/**/*",
		"apps/launcher/test/**/*",
		"apps/launcher/test-e2e/**/*"
	],
	"exclude": [
		"**/dist/**"
	]
}
